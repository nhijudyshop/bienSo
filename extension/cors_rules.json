        { "header": "Access-Control-Allow-Headers", "operation": "set", "value": "Content-Type, Authorization, csrf, Accept, Accept-Language" },
        { "header": "Access-Control-Max-Age", "operation": "set", "value": "86400" }
      ]
    },
    "condition": {
      "urlFilter": "||dgbs.vpa.com.vn",
      "resourceTypes": ["xmlhttprequest", "other", "main_frame", "sub_frame"]
    }
  }
