": 0, "provincePriority": 1}, {"whLicensePlateId": "b0e26e4e-cfae-4444-b60a-a73c6afbd0c4", "idKy": "2025009", "licensePlate": "29E48222", "colorCode": "3", "requestId": "653c1ce4-750b-41ff-abb2-9d5ef3033895", "siteId": 1, "historyId": 5583776714528, "provinceCode": "01", "announcementName": "Phiên 9", "seqNumber": "48222", "plateType": 6, "plateSubType": 0, "provincePriority": 1}], "pageable": {"pageNumber": 0, "pageSize": 25, "sort": {"sorted": false, "unsorted": true, "empty": true}, "offset": 0, "paged": true, "unpaged": false}, "totalPages": 4703, "totalElements": 117568, "last": false, "first": true, "numberOfElements": 25, "size": 25, "number": 0, "sort": {"sorted": false, "unsorted": true, "empty": true}, "empty": false}, "/api/bidding/public-result/history/auction-result-session": {"content": [{"totalPlate": 495, "maxPrice": 1220000000, "minPrice": 5000000, "licensePlate": "37C56789", "auctionDate": "16/04/2026", "id": 20260416}, {"totalPlate": 644, "maxPrice": 8030000000, "minPrice": 5000000, "licensePlate": "50AA80308", "auctionDate": "15/04/2026", "id": 20260415}, {"totalPlate": 729, "maxPrice": 5100000000, "minPrice": 5000000, "licensePlate": "70AA73366", "auctionDate": "14/04/2026", "id": 20260414}, {"totalPlate": 819, "maxPrice": 930000000, "minPrice": 5000000, "licensePlate": "50AA93223", "auctionDate": "13/04/2026", "id": 20260413}, {"totalPlate": 691, "maxPrice": 5875000000, "minPrice": 5000000, "licensePlate": "15AF21388", "auctionDate": "10/04/2026", "id": 20260410}], "totalElements": 511}, "/search-api/search/list-announcement-plan-code": [{"announcementPlanCode": "Phiên 10", "announcementPlateId": null, "announcementCode": "2026010"}, {"announcementPlanCode": "Phiên 9", "announcementPlateId": null, "announcementCode": "2025009"}, {"announcementPlanCode": "Phiên 8", "announcementPlateId": null, "announcementCode": "2025008"}, {"announcementPlanCode": "Phiên 7", "announcementPlateId": null, "announcementCode": "2025007"}, {"announcementPlanCode": "Phiên 6", "announcementPlateId": null, "announcementCode": "2025006"}, {"announcementPlanCode": "Phiên 5", "announcementPlateId": null, "announcementCode": "2024005"}, {"announcementPlanCode": "Phiên 4", "announcementPlateId": null, "announcementCode": "2024004"}, {"announcementPlanCode": "Phiên 3", "announcementPlateId": null, "announcementCode": "2024003"}, {"announcementPlanCode": "Phiên 2", "announcementPlateId": null, "announcementCode": "2023002"}, {"announcementPlanCode": "Phiên 1", "announcementPlateId": null, "announcementCode": "2023001"}], "/api/tin-tuc/faq/get-faq": [{"question": "Sau khi trúng đấu giá tôi phải làm gì để đăng ký biển số trúng đấu giá?", "lastUpdated": 1744008395106, "answer": "\"Khách hàng trúng đấu giá cần thực hiện những thủ tục sau để có thể đăng ký biển số xe trúng đấu giá\n\nXác nhận Biên bản đấu giá trực tuyến trong thời hạn quy định tại Quy chế đấu giá.\nNộp toàn bộ số tiền trúng đấu giá sau khi đã trừ số tiền đặt trước (nếu có) theo Thông báo kết quả trúng đấu giá do Cục cảnh sát giao thông gửi trong thời hạn 30 ngày kể từ ngày có văn bản điện tử Thông báo kết quả trúng đấu giá. Ngay sau khi nhận đủ số tiền trúng đấu giá, Cục Cảnh sát giao thông - Bộ Công an cấp hóa đơn điện tử bán tài sản công và văn bản điện tử Quyết định xác nhận biển số xe trúng đấu giá gửi vào địa chỉ thư điện tử (email) cho người trúng đấu giá để làm thủ tục đăng ký xe.\nThực hiện đăng ký cấp biển số xe trúng đấu giá tại Phòng Cảnh sát giao thông cấp tỉnh/thành phố nơi mình cư trú.\"", "id": 412250649972736, "attachments": []}, {"question": "Cách thức để tham gia đấu giá?", "lastUpdated": 1743997005725, "answer": "Bước 1: Bấm chọn Đăng ký/Đăng nhập, tiến hành tạo tài khoản hoặc đăng nhập tài khoản đã có. \nBước 3: Lựa chọn \"Danh sách công bố\" và/hoặc \"Danh sách chính thức\", nhập thông tin biển số xe mong muốn tại phần \"Tìm kiếm\".\nBước 4: Bấm chọn \"Đăng ký đấu giá\" để thanh toán hoặc thêm vào giỏ hàng, sau đó thực hiện thanh toán đơn hàng trong thời hạn quy định bằng cách quét mã QR hoặc chuyển khoản theo đúng số tài khoản ngân hàng, số tiền và nội dung chuyển khoản hiển thị tại màn hình thanh toán.\nLưu ý: Quý khách không được thay đổi số tiền và nội dung chuyển khoản sau khi quét mã QR thanh toán.\nBước 5: Khi đến thời gian đấu giá, khách hàng đăng nhập tài khoản đấu giá, sau đó lựa chọn \"Phòng đấu giá\" và nhập thông tin tài khoản, mã xác thực để tham gia phòng đấu giá thực hiện trả giá.\nBước 6: Kết thúc cuộc đấu giá, truy cập \"Kết quả đấu giá\" để xem giá trúng cao nhất.", "id": 2272692892651520, "attachments": []}, {"question": "Thời hạn để đăng ký biển số xe trúng đấu giá là bao nhiêu lâu?", "lastUpdated": 1743997210181, "answer": "Thời hạn để quý khách thực hiện thủ tục đăng ký xe để gắn biển số xe trúng đấu giá là trong 12 tháng kể từ ngày được cấp Quyết định xác nhận biển số xe trúng đấu giá; trường hợp sự kiện bất khả kháng hoặc trở ngại khách quan thì thời hạn này được kéo dài thêm nhưng tối đa không quá 06 tháng theo quy định điểm b khoản 2 Điều 38 Luật Trật tự, an toàn giao thông đường bộ năm 2024.", "id": 3576255228989440, "attachments": []}, {"question": "Tôi có thể nhận được thông báo đấu giá bằng những cách nào?", "lastUpdated": 1743997467087, "answer": "Khách hàng đăng ký đấu giá thành công sẽ nhận được thông báo mã xác thực thông qua địa chỉ hòm thư điện tử (email), tin nhắn về số điện thoại; còn lịch đấu giá, xác nhận thanh toán,... thì thông báo còn được gửi trên app ĐGBS mà Quý khách đã đăng ký tại tài khoản đấu giá trực tuyến của mình.", "id": 8446953381277696, "attachments": []}, {"question": "Tôi có thể đăng ký đấu giá bao nhiêu biển số?", "lastUpdated": 1743996329141, "answer": "Hiện nay, không có quy định về việc giới hạn số lượng biển số xe mà cá nhân/tổ chức có thể đăng ký đấu giá. Vì vậy, Quý khách hàng có thể đăng ký không giới hạn số lượng biển số xe và sở hữu nhiều biển số xe trúng đấu giá. Tuy nhiên, các biển số mà Quý khách đăng ký đấu giá phải tuân thủ các quy định pháp luật về biển số xe, như:\n1) Đã được niêm yết đủ thời gian theo quy định; \n2) Cho phép đăng ký đấu giá trên trang đấu giá trực tuyến; \n3) Việc chuyển nhượng biển số xe trúng đấu giá mà không kèm theo xe là trái quy định pháp luật.", "id": 8447023107387392, "attachments": []}, {"question": "Tôi có bị giới hạn số lần trả giá hay không?", "lastUpdated": 1743996248970, "answer": "Theo quy định pháp luật về đấu giá trực tuyến biển số xe, hiện tại không có quy định giới hạn số lần trả giá trong một cuộc đấu giá. Do đó, Quý khách có thể trả giá nhiều lần trong suốt thời gian diễn ra cuộc đấu giá. Chi tiết về cách thức trả giá hợp lệ, Quý khách vui lòng đọc kỹ Quy chế đấu giá đấu giá trực tuyến biển số xe.", "id": 8447134256443392, "attachments": []}, {"question": "Kiểm tra lịch sử đấu giá như thế nào?", "lastUpdated": 1743996218602, "answer": "Để xem lại lịch sử đấu giá, Quý khách thực hiện đăng nhập tài khoản đấu giá, sau đó lựa chọn mục “Lịch sử đấu giá” để kiểm tra thông tin đấu giá của từng biển số xe. Trường hợp Quý khách muốn xem chi tiết quá trình trả giá trong một cuộc đấu giá cụ thể, tại cột \"Diễn biến\" Quý khách bấm chọn \"Xem chi tiết\".", "id": 8447231539130368, "attachments": []}, {"question": "Nếu tôi không tham dự cuộc đấu giá trong thời gian diễn ra cuộc đấu giá thì sao?", "lastUpdated": 1743997499477, "answer": "Nếu khách hàng đủ điều kiện tham gia đấu giá biển số xe nhưng không đăng nhập vào tài khoản đã được cấp và không truy cập vào phòng đấu giá để tham gia trong thời gian đấu giá chính thức, khách hàng sẽ được coi là không tham gia đấu giá. Trong trường hợp này, khách hàng sẽ không được nhận lại tiền đặt trước theo quy định tại khoản 4 Điều 25 Nghị định 156/2024/NĐ-CP về đấu giá biển số xe.", "id": 8447335453011968, "attachments": []}, {"question": "Tôi muốn xem danh sách kết quả đấu giá?", "lastUpdated": 1743997324239, "answer": "Quý khách có thể truy cập vào Trang thông tin đấu giá trực tuyến tại địa chỉ: http://vpa.com.vn hoặc http://dgbs.vpa.com.vn và chọn mục \"Kết quả đấu giá\" và tra cứu thông tin biển số quý khách muuốn để theo dõi hoặc xem danh sách kết quả đấu giá.", "id": 8447389014274048, "attachments": []}, {"question": "Trường hợp tham gia không trúng đấu giá?", "lastUpdated": 1743997555664, "answer": "Trường hợp khách hàng tham gia không trúng đấu giá và không thuộc những trường hợp không được nhận lại tiền đặt trước theo Quy chế đấu giá thì quý khách sẽ được hoàn lại số tiền đặt trước trong vòng 03 ngày làm việc (không bao gồm thứ bảy, chủ nhật) kể từ ngày kết thúc cuộc đấu giá.", "id": 9977903149076480, "attachments": []}, {"question": "Làm thế nào để thanh toán cho biển số mình muốn đấu giá?", "lastUpdated": 1743996276392, "answer": "Để thanh toán tiền hồ sơ, tiền đặt trước cho biển số mà mình muốn tham gia đấu giá, Quý khách thực hiện đăng nhập tài khoản đấu giá, nhập biển số xe cần tìm tại mục \"Danh sách công bố\" và/hoặc \"Danh sách chính thức\", chọn mục \"Đăng ký đấu giá\" đối với biển số đó. Sau đó, thực hiện thanh toán đơn hàng trong thời gian đăng ký đấu giá bằng cách quét mã QR hoặc chuyển khoản theo đúng số tài khoản ngân hàng, số tiền và nội dung chuyển khoản hiển thị tại màn hình thanh toán.\nTrường hợp Quý khách hàng đã thêm biển số yêu thích vào giỏ hàng, Quý khách vui lòng truy cập mục \"Giỏ hàng\", lựa chọn chức năng \"Thanh toán\" và thực hiện thanh toán đơn hàng như hướng dẫn trên.  \nLưu ý: Quý khách không được thay đổi số tiền và nội dung chuyển khoản sau khi quét mã QR thanh toán.", "id": 8447083899629568, "attachments": []}, {"question": "Giá trị khởi điểm và giá trị tối đa của biển số xe đấu giá trực tuyến được tính ra sao?", "lastUpdated": 1743996533672, "answer": "1. Căn cứ Điều 6 Nghị định 156/2024/NĐ-CP ngày 10/12/2024 quy định giá khởi điểm của một biển số xe đưa ra đấu giá như sau: \na) Đối với biển số xe ô tô: 40.000.000 đồng, ba năm tăng một lần tính từ ngày 01 tháng 01 năm 2025, mỗi lần tăng 5.000.000 đồng.\nb) Đối với biển số xe mô tô, xe gắn máy: 5.000.000 đồng, ba năm tăng một lần tính từ ngày 01 tháng 01 năm 2025, mỗi lần tăng 1.000.000 triệu đồng.\nc) Đối với biển số xe có định dạng AAAAA (A>4), ABCDE (A<B<C<D<E, A>4) đưa ra đấu giá lại sau lần thứ hai là 500.000.000 đồng đối với biển số xe ô tô và 50.000.000 đồng đối với biển số xe mô tô, xe gắn máy.\n2. Hiện nay không có quy định về giá trị tối đa của một biển số xe đấu giá trực tuyến, giá trị tối đa sẽ là giá trả cao nhất mà khách hàng trả giá hợp lệ được hệ thống đấu giá ghi nhận tại thời điểm kết thúc cuộc đấu giá.", "id": 8446859965739008, "attachments": []}], "/api/tin-tuc/public/api/get-public-file": {"result": [{"documentFile": "https://s3-hfx03.fptcloud.com/daugia/thong-bao-dau-gia/4931598128889856_signed_thong bao thoi gian dau gia truc tuyen bien so xe ngay 2242026.pdf", "nameFile": "Thông báo thời gian đấu giá trực tuyến biển số xe ngày 22/4/2026", "timePublic": 1776186000000}, {"documentFile": "https://s3-hfx03.fptcloud.com/daugia/thong-bao-dau-gia/4541705712156672_signed_thong bao thoi gian dau gia truc tuyen bien so xe ngay 2142026.pdf", "nameFile": "Thông báo thời gian đấu giá trực tuyến biển số xe ngày 21/4/2026", "timePublic": 1776099600000}, {"documentFile": "https://s3-hfx03.fptcloud.com/daugia/thong-bao-dau-gia/4121253571313664_signed_thong bao thoi gian dau gia truc tuyen bien so xe ngay 2042026.pdf", "nameFile": "Thông báo thời gian đấu giá trực tuyến biển số xe ngày 20/4/2026", "timePublic": 1776013200000}, {"documentFile": "https://s3-hfx03.fptcloud.com/daugia/thong-bao-dau-gia/2128093239869440_Quyết định về việc ban hành Quy chế đấu giá trực tuyến biển số xe Phiên đấu giá thứ 10.pdf", "nameFile": "Quyết định về việc ban hành Quy chế đấu giá trực tuyến biển số xe Phiên đấu giá thứ 10", "timePublic": 1775754000000}, {"documentFile": "https://s3-hfx03.fptcloud.com/daugia/thong-bao-dau-gia/2127931696250880_Thông báo công bố danh sách biển số xe đưa ra đấu giá Phiên đấu giá thứ 10.pdf", "nameFile": "Thông báo công bố danh sách biển số xe đưa 